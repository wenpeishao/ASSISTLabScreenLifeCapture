<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Capture Control Card (filled) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen Capture"
                    android:textAppearance="@style/MindPulse.Text.TitleMedium"
                    android:textColor="@color/md_theme_onSurface" />

                <Switch
                    android:id="@+id/switchCapture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:thumbTint="@color/switch_thumb_tint"
                    android:trackTint="@color/switch_track_tint"
                    android:showText="true"
                    android:textOff="Off"
                    android:textOn="On" />

                <TextView
                    android:id="@+id/captureState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/capture_state_off"
                    android:textAppearance="@style/MindPulse.Text.BodySmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Data Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/imageNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Images: 0"
                    android:textAppearance="@style/MindPulse.Text.BodyMedium"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:id="@+id/uploadNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Not Uploading"
                    android:textAppearance="@style/MindPulse.Text.BodyMedium"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Network Settings Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Settings"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use Mobile Data"
                            android:textAppearance="@style/MindPulse.Text.BodyLarge"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allow uploads when WiFi unavailable"
                            android:textAppearance="@style/MindPulse.Text.BodySmall"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/mobileDataSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:thumbTint="@color/switch_thumb_tint"
                        android:trackTint="@color/switch_track_tint"
                        android:showText="true"
                        android:textOff="No"
                        android:textOn="Yes" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Permissions Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Permissions"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap any row to open its settings"
                    android:textAppearance="@style/MindPulse.Text.BodySmall"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <!-- Camera Permission -->
                <LinearLayout
                    android:id="@+id/cameraPermissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/cameraPermissionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Camera (QR Scanning)"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

                <!-- Location Permission -->
                <LinearLayout
                    android:id="@+id/locationPermissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/locationPermissionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location (Background)"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

                <!-- Usage Access Permission -->
                <LinearLayout
                    android:id="@+id/usageAccessRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/usageAccessDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Usage Access (App Stats)"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

                <!-- Notification Permission -->
                <LinearLayout
                    android:id="@+id/notificationPermissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/notificationPermissionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notifications"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

                <!-- Battery Optimization Permission -->
                <LinearLayout
                    android:id="@+id/batteryPermissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/batteryPermissionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Battery Optimization (Unrestricted)"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

                <!-- Accessibility Capture Permission -->
                <LinearLayout
                    android:id="@+id/accessibilityPermissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/accessibilityPermissionDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/permission_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility Capture"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurface" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Accessibility Capture Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Accessibility Capture"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Accessibility Capture instead of the regular screen recording permission."
                    android:textAppearance="@style/MindPulse.Text.BodyMedium"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/accessibilityModeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Standard screen recording is selected."
                    android:textAppearance="@style/MindPulse.Text.BodySmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <Button
                    android:id="@+id/accessibilityCaptureButton"
                    style="@style/MindPulse.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable Accessibility Capture" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Actions Card (filled) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actions"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/uploadButton"
                    style="@style/MindPulse.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload and Clear All Files" />

                <Button
                    android:id="@+id/updateQRButton"
                    style="@style/MindPulse.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Update QR Code" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
