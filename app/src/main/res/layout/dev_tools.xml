<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    tools:context=".DevToolsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developer Tools"
            android:textAppearance="@style/MindPulse.Text.HeadlineSmall"
            android:textColor="@color/md_theme_onSurface"
            android:layout_marginBottom="16dp" />

        <!-- 1. Data Management Card (outlined, error stroke) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:strokeColor="@color/md_theme_error">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Management"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_error"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/clearPrefs"
                    style="@style/MindPulse.Button.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset Username and Password" />

                <Button
                    android:id="@+id/clearImages"
                    style="@style/MindPulse.Button.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clear Images" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Upload Testing Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Testing"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/attemptUpload"
                    style="@style/MindPulse.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Attempt Upload in 10s" />

                <Button
                    android:id="@+id/attemptUpload2"
                    style="@style/MindPulse.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Attempt Upload in 5m" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Configuration Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuration"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Batch size">

                        <EditText
                            android:id="@+id/batchSizeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/setBatchSizeButton"
                        style="@style/MindPulse.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Max images to send">

                        <EditText
                            android:id="@+id/maxSendInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/setMaxSendButton"
                        style="@style/MindPulse.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Network Testing Card (outlined) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Testing"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/testWifiButton"
                        style="@style/MindPulse.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test WiFi" />

                    <TextView
                        android:id="@+id/wifiResultText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                </LinearLayout>

                <TextView
                    android:id="@+id/wifiTestEndpointResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/MindPulse.Text.BodySmall"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/testMobileButton"
                        style="@style/MindPulse.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Mobile" />

                    <TextView
                        android:id="@+id/mobileResultText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/MindPulse.Text.BodyMedium"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Capture"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable internal test mode"
                            android:textAppearance="@style/MindPulse.Text.BodyLarge"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Routes screen capture through Accessibility instead of MediaProjection"
                            android:textAppearance="@style/MindPulse.Text.BodySmall"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/accessibilityCaptureSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:showText="true"
                        android:textOff="Off"
                        android:textOn="On"
                        android:thumbTint="@color/switch_thumb_tint"
                        android:trackTint="@color/switch_track_tint" />

                </LinearLayout>

                <Button
                    android:id="@+id/openAccessibilitySettingsButton"
                    style="@style/MindPulse.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open Accessibility Settings" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VLM Benchmark Card (hidden in the standard flavor at runtime) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vlmCard"
            style="@style/MindPulse.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:strokeColor="@color/md_theme_tertiary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VLM Benchmark"
                    android:textAppearance="@style/MindPulse.Text.TitleSmall"
                    android:textColor="@color/md_theme_tertiary"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable on-device VLM"
                            android:textAppearance="@style/MindPulse.Text.BodyLarge"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Runs inference on each captured screenshot"
                            android:textAppearance="@style/MindPulse.Text.BodySmall"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/vlmBenchmarkSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:thumbTint="@color/switch_thumb_tint"
                        android:trackTint="@color/switch_track_tint" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Model path (GGUF)">

                    <EditText
                        android:id="@+id/vlmModelPathInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="mmproj path (optional, for non-unified models)">

                    <EditText
                        android:id="@+id/vlmMmprojPathInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/vlmStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not running"
                    android:textAppearance="@style/MindPulse.Text.BodyMedium"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/vlmMetricsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last: --  Avg: --  Total: 0  Skipped: 0  Battery: --"
                    android:textAppearance="@style/MindPulse.Text.BodySmall"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Threads">

                        <EditText
                            android:id="@+id/vlmThreadsInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:inputType="number"
                            android:text="4" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/vlmExportLogButton"
                        style="@style/MindPulse.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export Log" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/disableButton"
            style="@style/MindPulse.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable Dev Tools" />

    </LinearLayout>

</ScrollView>
