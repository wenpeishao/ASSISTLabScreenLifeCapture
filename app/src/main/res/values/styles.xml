<resources>

    <!-- Base theme with all M3 color roles -->
    <style name="AppTheme.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <item name="android:colorBackground">@color/md_theme_surface</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- AppTheme for pre-v31 (no splash screen API) -->
    <style name="AppTheme" parent="AppTheme.Base" />

    <!-- Button styles -->
    <style name="MindPulse.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MindPulse.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MindPulse.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MindPulse.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MindPulse.Button.Error" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/md_theme_error</item>
    </style>

    <!-- Card styles -->
    <style name="MindPulse.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="MindPulse.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="MindPulse.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Typography styles -->
    <style name="MindPulse.Text.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="MindPulse.Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium" />
    <style name="MindPulse.Text.TitleSmall" parent="TextAppearance.Material3.TitleSmall" />
    <style name="MindPulse.Text.BodyLarge" parent="TextAppearance.Material3.BodyLarge" />
    <style name="MindPulse.Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium" />
    <style name="MindPulse.Text.BodySmall" parent="TextAppearance.Material3.BodySmall" />
    <style name="MindPulse.Text.LabelLarge" parent="TextAppearance.Material3.LabelLarge" />
    <style name="MindPulse.Text.LabelMedium" parent="TextAppearance.Material3.LabelMedium" />

    <!-- Switch style (reference only, Java uses android.widget.Switch) -->
    <style name="MindPulse.Switch" parent="Widget.Material3.CompoundButton.Switch" />

    <!-- Legacy compatibility -->
    <style name="SwitchCompatStyle">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="trackTint">@color/light_sea_green</item>
    </style>

</resources>
