<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    Research-flavour network policy. This file REPLACES the production one for
    mindpulseDev builds only; app/src/main/.../network_security_config.xml is
    untouched and is what ships to participants.

    The only difference is the first block: loopback may be reached in the
    clear. That is what lets a tethered test device talk to a receiver running
    on the workstation it is plugged into:

        phone 127.0.0.1:8099  ->  [adb reverse]  ->  workstation  ->  receiver

    which is the only way to exercise the real phone stack end to end. SSH is
    filtered from the lab network to every SSCC host, so a tunnel to the test
    instance on the receiver host is not available, and only :443 is open
    inbound there.

    Loopback is not a security hole worth trading away: adb reverse only maps a
    port for a device physically attached over USB, and nothing on the network
    can reach 127.0.0.1 on the phone.

    The production pin-set below is kept deliberately. A dev build pointed at
    the real receiver must behave exactly like a production build, or it proves
    nothing about the thing we are testing.
-->
<network-security-config>
    <!-- Loopback, in the clear: the tethered-testing path described above. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Identical to production: TLS + pinning on the issuing CA chain.
         Pins are the CA chain, not the leaf, so the yearly certificate renewal
         does not require an app release. The InCommon leaf expires 2026-09-25
         and SSCC is migrating the host to Let's Encrypt; both CA families are
         pinned below so the cutover cannot strand any installed build. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mindpulse.ssc.wisc.edu</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!-- Two CA families, deliberately, because the server is migrating from
             InCommon to Let's Encrypt (SSCC, Aug 2026). A pin-set matches if ANY
             validated-chain cert matches ANY pin, so carrying both makes the
             cutover order-independent: phones on this build work before, during
             and after the switch. Remove the InCommon pair only after the
             receiver has moved and no supported build predates this one.

             Let's Encrypt is pinned at the ROOTS, never the intermediates: LE
             rotates intermediates (the 2026 chain is leaf -> YR1 -> ISRG Root
             YR, cross-signed by ISRG Root X1). Three roots cover every path:
             X1 (RSA anchor to 2035; also validates the cross-sign on devices
             that trust only X1), X2 (ECDSA anchor to 2040, in case certbot is
             ever switched to an ECDSA profile), and Root YR (the 2026 root, for
             newer devices that trust it directly; on those the chain
             terminates at YR and an X1-only pin would not match). Pins for
             X1/X2 computed from letsencrypt.org/certs; Root YR from the live
             chain on mirror.ssc.wisc.edu, SSCC's existing LE deployment. -->
        <pin-set expiration="2027-07-08">
            <!-- InCommon (current cert, until the migration) -->
            <pin digest="SHA-256">nIUvrOVzCyKOqY+U4sofEeIMk94Dt/WuMgaesi8NITk=</pin>
            <pin digest="SHA-256">x4QzPSC810K5/cMjb05Qm4k3Bw5zBn4lTdO/nEW/Td4=</pin>
            <!-- Let's Encrypt: ISRG Root X1, ISRG Root X2, ISRG Root YR -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
        </pin-set>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
